@page "/"

@using EasyBudget.Data
@using EasyBudget.Models
@using EasyBudget.ViewModels
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>EasyBudget - Home</PageTitle>


<div class="container">
    <div class="mb-4">
        <h1>Dashboard</h1>
        <p class="text-muted">
            Your financial overview for @DateTime.Today.ToString("MMMM yyyy")
        </p>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title text-muted">Monthly income</h5>
                    <h3 class="text-success">
                        @dashboardSummary.TotalIncome.ToString("C2",
                            System.Globalization.CultureInfo.GetCultureInfo("en-IE"))
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title text-muted">Monthly expenses</h5>
                    <h3 class="text-danger">
                        @dashboardSummary.TotalExpenses.ToString("C2",
                            System.Globalization.CultureInfo.GetCultureInfo("en-IE"))
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title text-muted">Monthly balance</h5>
                    <h3 class="@(dashboardSummary.Balance >= 0
                                                ? "text-success" : "text-danger")">
                        @dashboardSummary.Balance.ToString("C2",
                            System.Globalization.CultureInfo.GetCultureInfo("en-IE"))
                    </h3>
                </div>
            </div>
        </div>
    </div>
</div>


@code {
    private DashboardSummary dashboardSummary = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashBoardSummaryAsync();
    }

    private async Task LoadDashBoardSummaryAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var startOfMonth = new DateOnly(today.Year, today.Month, 1);
        var startOfNextMonth = startOfMonth.AddMonths(1);

        await using var dbContext = DbFactory.CreateDbContext();

        var monthlyTransactions = dbContext.Transactions.Where(transaction => transaction.Date >= startOfMonth && transaction.Date < startOfNextMonth);

        dashboardSummary.TotalIncome = await monthlyTransactions
                                                .Where(transation => transation.TransactionType == TransactionType.Income)
                                                .SumAsync(transaction => transaction.Amount);

        dashboardSummary.TotalExpenses = await monthlyTransactions
                                                        .Where(transation => transation.TransactionType == TransactionType.Expense)
                                                        .SumAsync(transaction => transaction.Amount);

        
    }
}
