@page "/"

@using System.Globalization
@using EasyBudget.Data
@using EasyBudget.Models
@using EasyBudget.ViewModels
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>EasyBudget - Home</PageTitle>


<div class="container">
    <div class="mb-4">
        <h1>Dashboard</h1>
        <p class="text-muted">
            Your financial overview for @displayMonth.ToString("MMMM yyyy")
        </p>
    </div>

    
    <div class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label for="month" class="form-label">Month</label>
            <InputSelect id="month"
                         class="form-select"
                         @bind-Value="selectedMonth">
                @for (int month = 1; month <= 12; month++)
                {
                    <option value="@month">
                        @CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)
                    </option>
                }
            </InputSelect>
        </div>

        <div class="col-auto">
            <label for="year" class="form-label">Year</label>
            <InputSelect id="year"
                         class="form-select"
                         @bind-Value="selectedYear">
                @for (int year = DateTime.Now.Year - 5;
                      year <= DateTime.Now.Year + 5;
                      year++)
                {
                    <option value="@year">@year</option>
                }
            </InputSelect>
        </div>

        <div class="col-auto">
            <button class="btn btn-primary"
                    @onclick="LoadDashboardDataAsync">
                Apply
            </button>
        </div>
    </div>


    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title text-muted">Monthly income</h5>
                    <h3 class="text-success">
                        @dashboardSummary.TotalIncome.ToString("C2",
                            System.Globalization.CultureInfo.GetCultureInfo("en-IE"))
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title text-muted">Monthly expenses</h5>
                    <h3 class="text-danger">
                        @dashboardSummary.TotalExpenses.ToString("C2",
                            System.Globalization.CultureInfo.GetCultureInfo("en-IE"))
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title text-muted">Monthly balance</h5>
                    <h3 class="@(dashboardSummary.Balance >= 0
                                                ? "text-success" : "text-danger")">
                        @dashboardSummary.Balance.ToString("C2",
                            System.Globalization.CultureInfo.GetCultureInfo("en-IE"))
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <hr />

    <h4>Recent transactions</h4>

    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <p class="text-danger">@loadError</p>
    }
    else if (recentTransactions.Count == 0)
    {
        <p class="text-muted">No transactions recorded for the selected month.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Transaction transaction in recentTransactions)
                    {
                        <tr @key="transaction.Id">
                            <td>@transaction.Date.ToString("dd-MM-yyyy")</td>
                            <td>@transaction.TransactionType</td>
                            <td>@transaction.Category</td>
                            <td>@transaction.Description</td>
                            <td class="text-end">
                                @if (transaction.TransactionType == TransactionType.Expense)
                                {
                                    <span>-@transaction.Amount.ToString("C2",
                                        System.Globalization.CultureInfo.GetCultureInfo("en-IE"))</span>
                                }
                                else
                                {
                                    <span>+@transaction.Amount.ToString("C2",
                                        System.Globalization.CultureInfo.GetCultureInfo("en-IE"))</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    }
</div>


@code {
    private DashboardSummary dashboardSummary = new();
    private List<Transaction> recentTransactions = new();

    private bool isLoading;
    private string loadError = string.Empty;
    private int selectedMonth;
    private int selectedYear;
    private DateOnly displayMonth;

    protected override async Task OnInitializedAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        selectedMonth = today.Month;
        selectedYear = today.Year;

        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        try
        {
            isLoading = true;
            loadError = string.Empty;

            displayMonth = new DateOnly(selectedYear, selectedMonth, 1);
            var startOfNextMonth = displayMonth.AddMonths(1);

            await using var dbContext = DbFactory.CreateDbContext();

            var monthlyTransactions = dbContext.Transactions.Where(transaction => transaction.Date >= displayMonth && transaction.Date < startOfNextMonth);

            dashboardSummary.TotalIncome = await monthlyTransactions
                                                    .Where(transation => transation.TransactionType == TransactionType.Income)
                                                    .SumAsync(transaction => transaction.Amount);

            dashboardSummary.TotalExpenses = await monthlyTransactions
                                                            .Where(transaction => transaction.TransactionType == TransactionType.Expense)
                                                            .SumAsync(transaction => transaction.Amount);

            recentTransactions = await monthlyTransactions
                                                .OrderByDescending(transaction => transaction.Date)
                                                .ThenByDescending(transaction => transaction.Id)
                                                .Take(5)
                                                .ToListAsync();
        }
        catch
        {
            loadError = "An error occured while loading data.";
        }
        finally
        {
            isLoading = false;
        }
    }
}