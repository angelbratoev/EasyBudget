@page "/transactions"

@using EasyBudget.Models
@using EasyBudget.Components.Shared;
@using Microsoft.AspNetCore.Components.Forms
@using EasyBudget.Data
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Transactions - EasyBudget</PageTitle>

<div class="container mt-4">
    <h1>Transactions</h1>
    <p class="text-muted">
        Record your income and expenses.
    </p>

    <hr />

    <button type="button"
            class="btn btn-sm btn-primary"
            @onclick="() => BringTransactionForm()">
        New transaction
    </button>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(saveSucceeded ? "alert-success" : "alert-danger") mt-3" role="alert">
            @statusMessage
        </div>
    }

    <hr class="my-4" />

    <h2>Transaction history</h2>

    @if (isLoading)
    {
        <p>Loading transactions...</p>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <p class="text-danger">@loadError</p>
    }
    else if (transactions.Count == 0)
    {
        <p class="text-muted">No transactions yet. Add your first transaction using the form above.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th class="text-end">Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Transaction transaction in transactions)
                    {
                        <tr @key="transaction.Id">
                            <td>@transaction.Date.ToString("dd-MM-yyyy")</td>
                            <td>@transaction.TransactionType</td>
                            <td>@transaction.Category</td>
                            <td>@transaction.Description</td>
                            <td class="text-end">
                                @if (transaction.TransactionType == TransactionType.Expense)
                                {
                                    <span>-@transaction.Amount.ToString("N2")</span>
                                }
                                else
                                {
                                    <span>+@transaction.Amount.ToString("N2")</span>
                                }
                            </td>
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        @onclick="() => EditTransactionAsync(transaction.Id)"
                                        disabled="@isSaving">
                                    Edit
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        @onclick="() => ConfirmDelete(transaction.Id)"
                                        disabled="@isSaving">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    }

    @if (pendingDeleteId.HasValue)
    {
        <div class="modal d-block"
             tabindex="-1"
             role="dialog"
             aria-modal="true"
             aria-labelledby="deleteModalTitle">

            <div class="modal-dialog modal-dialog-centered"
                 role="document">

                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteModalTitle">
                            Delete transaction?
                        </h5>
                    </div>

                    <div class="modal-body">
                        <p>
                            Are you sure you want to delete this transaction?
                        </p>
                        <p class="text-muted mb-0">
                            This action cannot be undone.
                        </p>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="CancelDelete"
                                disabled="@isSaving">
                            Cancel
                        </button>

                        <button type="button"
                                class="btn btn-danger"
                                @onclick="() => DeleteTransactionAsync(pendingDeleteId.Value)"
                                disabled="@isSaving">
                            @(isSaving ? "Deleting..." : "Delete")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-backdrop fade show"></div>
    }

    @if (showTransactionForm && !editingTransactionId.HasValue)
    {
        <div class="modal d-block"
             tabindex="-1"
             role="dialog"
             aria-modal="true"
             aria-labelledby="addModalTitle">

            <div class="modal-dialog modal-dialog-centered"
                 role="document">

                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addModalTitle">
                            Add new transaction
                        </h5>
                    </div>

                    <div class="modal-body">
                        <TransactionForm Model="newTransaction"
                                         OnValidSubmit="HandleValidSubmit"
                                         OnCancel="CancelNewTransaction"
                                         IsSaving="isSaving" />
                    </div>

                </div>
            </div>
        </div>

        <div class="modal-backdrop fade show"></div>
    }

    @if (showTransactionForm && editingTransactionId.HasValue)
    {
        <div class="modal d-block"
             tabindex="-1"
             role="dialog"
             aria-modal="true"
             aria-labelledby="editModalTitle">

            <div class="modal-dialog modal-dialog-centered"
                 role="document">

                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editModalTitle">
                            Edit transaction
                        </h5>
                    </div>

                    <div class="modal-body">
                        <TransactionForm Model="newTransaction"
                                         OnValidSubmit="HandleValidSubmit"
                                         OnCancel="CancelEdit"
                                         IsSaving="isSaving"
                                         IsEditing="editingTransactionId.HasValue" />
                    </div>

                </div>
            </div>
        </div>

        <div class="modal-backdrop fade show"></div>
    }

</div>

@code {
    private Transaction newTransaction = new();

    private List<Transaction> transactions = new();
    private bool isLoading;
    private bool isSaving;
    private bool saveSucceeded;
    private bool showTransactionForm;
    private string statusMessage = string.Empty;
    private string loadError = string.Empty;
    private int? editingTransactionId;
    private int? pendingDeleteId;

    protected override async Task OnInitializedAsync()
    {
        await LoadTransactionsAsync();
    }

    private void BringTransactionForm()
    {
        newTransaction = new Transaction();
        statusMessage = string.Empty;
        editingTransactionId = null;
        showTransactionForm = true;
    }

    private void CancelNewTransaction()
    {
        newTransaction = new Transaction();
        showTransactionForm = false;
        statusMessage = string.Empty;
    }

    private void CancelEdit()
    {
        newTransaction = new Transaction();
        editingTransactionId = null;
        statusMessage = string.Empty;
        showTransactionForm = false;
    }

    private void ConfirmDelete(int id)
    {
        statusMessage = string.Empty;
        pendingDeleteId = id;
    }

    private void CancelDelete()
    {
        pendingDeleteId = null;
    }

    private async Task DeleteTransactionAsync(int id)
    {
        if (isSaving || pendingDeleteId != id)
        {
            return;
        }

        isSaving = true;
        statusMessage = string.Empty;

        try
        {
            using var dbContext = DbFactory.CreateDbContext();

            Transaction transactionToDelete = await dbContext.Transactions
                                                             .FirstOrDefaultAsync(transaction => transaction.Id == id);

            if (transactionToDelete == null)
            {
                statusMessage = "Transaction does not exist. Refresh the page and try again.";
                saveSucceeded = false;
                return;
            }

            dbContext.Transactions.Remove(transactionToDelete);
            await dbContext.SaveChangesAsync();

            statusMessage = "Transaction deleted successfully.";
            saveSucceeded = true;
            pendingDeleteId = null;

            if (editingTransactionId == id)
            {
                editingTransactionId = null;
                newTransaction = new Transaction();
            }

            await LoadTransactionsAsync();
        }
        catch
        {
            statusMessage = "The transaction could not be deleted. Check the application logs for details.";
            saveSucceeded = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task EditTransactionAsync(int id)
    {
        try
        {
            using var dbContext = DbFactory.CreateDbContext();
            Transaction transaction = await dbContext.Transactions
                                                     .AsNoTracking()
                                                     .FirstOrDefaultAsync(transaction => transaction.Id == id);

            if (transaction == null)
            {
                statusMessage = "The selected transaction could not be found.";
                saveSucceeded = false;
                return;
            }

            newTransaction = new Transaction
            {
                Amount = transaction.Amount,
                Category = transaction.Category,
                Date = transaction.Date,
                Description = transaction.Description,
                TransactionType = transaction.TransactionType
            };

            editingTransactionId = transaction.Id;
            showTransactionForm = true;
        }
        catch
        {
            statusMessage = "The transaction could not be loaded for editing.";
            saveSucceeded = false;
        }
    }

    private async Task LoadTransactionsAsync()
    {
        isLoading = true;

        try
        {
            using var dbContext = DbFactory.CreateDbContext();

            transactions = await dbContext.Transactions
                                            .AsNoTracking()
                                            .OrderByDescending(transaction => transaction.Date)
                                            .ThenByDescending(transaction => transaction.Id)
                                            .ToListAsync();
        }
        catch
        {
            loadError = "Transactions could not be loaded. Check the application logs for details.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (isSaving)
            return;

        isSaving = true;

        try
        {
            using var dbContext = DbFactory.CreateDbContext();

            if (editingTransactionId.HasValue)
            {
                Transaction transactionToEdit = await dbContext.Transactions
                                                               .FirstOrDefaultAsync(transaction => transaction.Id == editingTransactionId);

                if (transactionToEdit == null)
                {
                    statusMessage = "Transaction does not exist. Please refresh the page.";
                    saveSucceeded = false;
                    return;
                }

                transactionToEdit.Amount = newTransaction.Amount;
                transactionToEdit.Category = newTransaction.Category.Trim();
                transactionToEdit.Date = newTransaction.Date;
                transactionToEdit.Description = string.IsNullOrEmpty(newTransaction.Description) ? null : newTransaction.Description.Trim();
                transactionToEdit.TransactionType = newTransaction.TransactionType;
            }
            else
            {
                Transaction transactionToSave = new()
                {
                    Amount = newTransaction.Amount,
                    Category = newTransaction.Category,
                    Date = newTransaction.Date,
                    Description = newTransaction.Description,
                    TransactionType = newTransaction.TransactionType
                };

                dbContext.Transactions.Add(transactionToSave);
            }

            await dbContext.SaveChangesAsync();

            statusMessage = editingTransactionId.HasValue ? "Transaction updated successfully." : "Transaction saved successfully.";
            saveSucceeded = true;
            showTransactionForm = false;
            editingTransactionId = null;

            newTransaction = new Transaction();
            await LoadTransactionsAsync();
        }
        catch
        {
            statusMessage = "The transaction could not be saved. Check the application logs for details.";
            saveSucceeded = false;
        }
        finally
        {
            isSaving = false;
        }
    }
}
